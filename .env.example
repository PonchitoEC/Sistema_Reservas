# Copia este archivo como .env para ejecutar el correo en local.
# No subas el archivo .env al repositorio.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=tu_correo@gmail.com
EMAIL_HOST_PASSWORD=tu_contrasena_de_aplicacion
EMAIL_TIMEOUT=15

# Producción gratuita en Render: API HTTPS de Brevo
BREVO_API_KEY=
BREVO_SENDER_EMAIL=remitente_verificado@ejemplo.com
BREVO_SENDER_NAME=Conexión Inmobiliaria
BREVO_TIMEOUT=20
